# Copy to `.env.production` and fill in REAL secrets. Never commit `.env.production`.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up

# ---- PostgreSQL (use a strong, unique password) ----
POSTGRES_USER=book_api
POSTGRES_PASSWORD=change-me-to-a-strong-secret
POSTGRES_DB=book_api_production

# ---- Rails ----
# Contents of config/master.key (decrypts credentials.yml.enc).
RAILS_MASTER_KEY=your-rails-master-key-here
