# Copy this file to `.env` and adjust values for your machine.
# `.env` is git-ignored and read by Docker Compose; NEVER commit real secrets.

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=book_api_development
POSTGRES_TEST_DB=book_api_test

# ---- Rails <-> Postgres connection ----
# Inside Docker Compose the database is reachable by the service name "db".
# When running Rails directly on your host, use "localhost".
DATABASE_HOST=db
DATABASE_PORT=5432

# ---- Rails ----
RAILS_ENV=development
RAILS_MAX_THREADS=5
# Log to STDOUT so `docker compose logs` shows everything.
RAILS_LOG_TO_STDOUT=true
