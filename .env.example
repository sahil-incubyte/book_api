# Copy this file to `.env` and adjust values for your machine.
# `.env` is git-ignored and read by Docker Compose; NEVER commit real secrets.

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=book_api_development
POSTGRES_TEST_DB=book_api_test

# ---- Rails <-> Postgres connection ----
# Inside Docker Compose the database is reachable by the service name "db".
# When running Rails directly on your host, use "localhost".
DATABASE_HOST=db
DATABASE_PORT=5432

# ---- Redis (caching / sessions) ----
# Inside Docker Compose, Redis is reachable by the service name "redis".
# When running Rails directly on your host, use redis://localhost:6379/0.
REDIS_URL=redis://redis:6379/0

# ---- Elasticsearch (full-text search / analytics) ----
# Inside Docker Compose, ES is reachable by the service name "elasticsearch".
# When running Rails directly on your host, use http://localhost:9202 (the
# container's 9200 is published on host port 9202 to avoid clashing with any
# other Elasticsearch/OpenSearch on 9200).
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---- Rails ----
RAILS_ENV=development
RAILS_MAX_THREADS=5
# Log to STDOUT so `docker compose logs` shows everything.
RAILS_LOG_TO_STDOUT=true
